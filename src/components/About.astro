---
const traits = [
  {
    title: 'Continuous Learning',
    description: 'Always exploring new tools, technologies, and better ways to build.',
  },
  {
    title: 'Team Collaboration',
    description: 'Building better software through communication, feedback, and shared ownership.',
  },
  {
    title: 'Problem Solving',
    description: 'Breaking complex challenges into clear, practical solutions.',
  },
  {
    title: 'Product Mindset',
    description: 'Looking beyond the code to understand the user and the problem being solved.',
  },
] as const;
---

<section id="about" class="about" aria-labelledby="about-title">
  <header class="about-heading">
    <div class="heading-row">
      <h2 id="about-title">02. ABOUT ME</h2>
      <span aria-hidden="true"></span>
    </div>
    <p>Engineer by profession. Builder by curiosity.</p>
  </header>

  <ul class="trait-list">
    {traits.map(({ title, description }) => (
      <li>
        <article>
          <h3>{title}</h3>
          <p>{description}</p>
        </article>
      </li>
    ))}
  </ul>
</section>

<style>
  @reference "../styles/global.css";

  .about {
    width: 100%;
    max-width: 42rem;
    min-width: 0;
  }

  .heading-row {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 4);
  }

  h2 {
    flex: none;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-label);
  }

  .heading-row span {
    width: min(12rem, 35vw);
    height: 1px;
    background: var(--color-border-subtle);
  }

  .about-heading > p {
    margin-top: calc(var(--spacing) * 4);
    color: var(--color-primary);
    font-size: var(--text-section);
    font-weight: var(--font-weight-semibold);
    line-height: var(--text-section--line-height);
  }

  .trait-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    gap: calc(var(--spacing) * 6);
    margin-top: calc(var(--spacing) * 12);
  }

  @media (width >= theme(--breakpoint-md)) {
    .trait-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .trait-list article {
    height: 100%;
    padding: calc(var(--spacing) * 6);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-small);
    background: var(--color-surface);
  }

  .trait-list h3 {
    color: var(--color-primary);
    font-weight: var(--font-weight-semibold);
  }

  .trait-list article > p {
    margin-top: calc(var(--spacing) * 3);
    color: var(--color-secondary);
  }
</style>
