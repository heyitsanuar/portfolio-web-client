---
const traits = [
  {
    title: 'Continuous Learning',
    description: 'Always exploring new technologies and better ways to build.',
    icon: 'learning',
  },
  {
    title: 'Team Collaboration',
    description: 'I enjoy working with others to turn ideas into real impact.',
    icon: 'collaboration',
  },
  {
    title: 'Problem Solving',
    description: 'I like tackling complex challenges and finding practical solutions.',
    icon: 'problem-solving',
  },
  {
    title: 'Product Mindset',
    description: 'Focused on building useful, user-centered experiences.',
    icon: 'product',
  },
] as const;
---

<section id="about" class="about" aria-labelledby="about-title">
  <header class="about-heading">
    <div class="heading-row">
      <h2 id="about-title">02. ABOUT ME</h2>
      <span aria-hidden="true"></span>
    </div>
    <p class="about-headline"><span>Engineer by </span><span class="accent-text">profession.</span><br /><span>Builder by </span><span class="accent-text">curiosity.</span></p>
    <p class="about-intro">Lifelong self-learner with a strong commitment to continuous growth, both independently and through collaboration. I enjoy turning ideas into thoughtful digital experiences and solving complex problems with technology.</p>
  </header>

  <ul class="trait-list">
    {traits.map(({ title, description, icon }) => (
      <li>
        <article>
          {icon === 'learning' && (
              <svg class="trait-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M3 5.5c3.2-1.3 6-.9 9 1.1v12c-3-2-5.8-2.4-9-1.1v-12ZM21 5.5c-3.2-1.3-6-.9-9 1.1v12c3-2 5.8-2.4 9-1.1v-12Z" />
                <path d="M12 6.6v12" />
              </svg>
          )}
          {icon === 'collaboration' && (
              <svg class="trait-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="9" cy="8" r="3" />
                <circle cx="17" cy="9" r="2.5" />
                <path d="M3.5 19c.6-3.2 2.4-5 5.5-5s4.9 1.8 5.5 5M14 14.5c2.9-.5 5 .9 6 3.5" />
              </svg>
          )}
          {icon === 'problem-solving' && (
              <svg class="trait-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M9 18h6M10 21h4M8.5 14.5a6 6 0 1 1 7 0c-.9.7-1.5 1.4-1.5 2.5h-4c0-1.1-.6-1.8-1.5-2.5Z" />
                <path d="M12 3v1M4.9 5.9l.7.7M19.1 5.9l-.7.7" />
              </svg>
          )}
          {icon === 'product' && (
              <svg class="trait-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="m4 16 4-8 4 4 3-6 5 10H4Z" />
                <path d="M12 4V2M18.5 5.5 20 4M5.5 5.5 4 4" />
              </svg>
          )}
          <div class="trait-content">
            <h3>{title}</h3>
            <p>{description}</p>
          </div>
        </article>
      </li>
    ))}
  </ul>
</section>

<style>
  @reference "../styles/global.css";

  .about {
    width: 100%;
    max-width: 42rem;
    min-width: 0;
  }

  .heading-row {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 4);
  }

  h2 {
    flex: none;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-label);
  }

  .heading-row span {
    width: min(12rem, 35vw);
    height: 1px;
    background: var(--color-border-subtle);
  }

  .about-headline {
    margin-top: calc(var(--spacing) * 4);
    color: var(--color-primary);
    font-size: var(--text-section);
    font-weight: var(--font-weight-semibold);
    line-height: var(--text-section--line-height);
  }

  .accent-text {
    color: var(--color-accent);
  }

  .trait-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: calc(var(--spacing) * 6);
    margin-top: calc(var(--spacing) * 12);
  }

  .trait-list article {
    display: grid;
    grid-template-columns: calc(var(--spacing) * 11) minmax(0, 1fr);
    column-gap: calc(var(--spacing) * 3);
    height: 100%;
    padding: calc(var(--spacing) * 3);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-small);
    background: color-mix(in srgb, var(--color-surface) 84%, transparent);
  }

  .trait-list h3 {
    color: var(--color-primary);
    font-weight: var(--font-weight-semibold);
  }

  .trait-icon {
    width: calc(var(--spacing) * 10);
    height: calc(var(--spacing) * 10);
    flex: none;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .trait-content > p {
    margin-top: calc(var(--spacing) * 1);
    color: var(--color-secondary);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
  }

  .trait-content {
    min-width: 0;
  }

  .about-intro {
    max-width: 42rem;
    margin-top: calc(var(--spacing) * 4);
    color: var(--color-secondary);
    font-size: var(--text-small);
    font-weight: 400;
    line-height: var(--text-body--line-height);
  }

  @media (width >= theme(--breakpoint-lg)) {
    .trait-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
