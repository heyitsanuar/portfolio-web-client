---
import SkillIcon from './SkillIcon.astro';

const tools = [
  { name: 'Claude Code', icon: 'claude' },
  { name: 'ChatGPT', icon: 'chatgpt' },
  { name: 'GitHub Copilot', icon: 'githubcopilot' },
  { name: 'Cursor', icon: 'cursor' },
  { name: 'MCP', icon: 'modelcontextprotocol' },
] as const;

const capabilities = ['Prompt Engineering', 'Agentic Workflows', 'AI-assisted Development'];
---

<section id="ai-agents" class="ai-agents" aria-labelledby="ai-agents-title" data-motion-reveal>
  <div class="capability-panel">
    <div class="panel-top">
      <header>
        <div class="panel-heading">
          <svg class="ai-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M12 2.5 13.7 10.3 21.5 12l-7.8 1.7L12 21.5l-1.7-7.8L2.5 12l7.8-1.7Z" />
            <path d="m5.2 5.2 2.2 2.2M18.8 5.2l-2.2 2.2M5.2 18.8l2.2-2.2M18.8 18.8l-2.2-2.2" />
          </svg>
          <h2 id="ai-agents-title">AI &amp; Agents</h2>
          <span class="featured-badge">Featured</span>
        </div>
      </header>

      <p class="panel-description">
        Using AI-assisted and agentic workflows to accelerate development, exploration, debugging,
        and delivery.
      </p>
    </div>

    <div class="panel-bottom">
      <ul class="tool-list" aria-label="AI tools">
        {tools.map(({ name, icon }) => (
          <li><SkillIcon name={icon} /><span>{name}</span></li>
        ))}
      </ul>

      <ul class="capability-list" aria-label="AI and agent capabilities">
        {capabilities.map((capability) => <li>{capability}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  @reference "../styles/global.css";

  .ai-agents {
    min-width: 0;
  }

  .capability-panel {
    display: grid;
    gap: calc(var(--spacing) * 4);
    min-width: 0;
    padding: calc(var(--spacing) * 5);
    border: 1px solid color-mix(in srgb, #9b7af5 48%, var(--color-border-subtle));
    border-radius: var(--radius-medium);
    background: color-mix(in srgb, var(--color-accent) 4%, var(--color-surface));
  }

  header,
  ul,
  li {
    min-width: 0;
  }

  h2 {
    color: #b06cff;
    font-size: var(--text-lead);
    font-weight: var(--font-weight-semibold);
    line-height: var(--text-lead--line-height);
  }

  .panel-heading {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: calc(var(--spacing) * 2.5);
  }

  .ai-icon {
    width: calc(var(--spacing) * 8);
    height: calc(var(--spacing) * 8);
    flex: none;
    fill: none;
    stroke: #b06cff;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .featured-badge {
    padding: 3px 7px;
    color: #67e8f9;
    border: 1px solid color-mix(in srgb, #67e8f9 62%, var(--color-border-subtle));
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: normal;
    text-transform: none;
    white-space: nowrap;
    text-transform: uppercase;
  }

  .panel-description {
    max-width: 40rem;
    color: var(--color-secondary);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .panel-top,
  .panel-bottom {
    display: grid;
    min-width: 0;
  }

  .panel-top {
    gap: calc(var(--spacing) * 3);
  }

  .panel-bottom {
    gap: calc(var(--spacing) * 3);
  }

  ul {
    min-width: 0;
  }

  .tool-list {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    gap: calc(var(--spacing) * 2) calc(var(--spacing) * 1.5);
    padding-block-end: calc(var(--spacing) * 4);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .tool-list li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(var(--spacing) * 1.5);
    min-width: 4rem;
    max-width: 7rem;
    color: var(--color-primary);
    font-size: 0.8125rem;
    text-align: center;
  }

  .tool-list li > span {
    min-width: 0;
    overflow-wrap: normal;
    word-break: normal;
  }

  .tool-list .skill-icon {
    width: calc(var(--spacing) * 6);
    height: calc(var(--spacing) * 6);
  }

  .capability-list {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--spacing) * 1);
  }

  .capability-list li {
    padding: calc(var(--spacing) * 1) calc(var(--spacing) * 1.5);
    overflow-wrap: normal;
    word-break: normal;
    color: var(--color-primary);
    border: 1px solid color-mix(in srgb, var(--color-accent) 35%, var(--color-border-subtle));
    border-radius: var(--radius-small);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  @media (width >= theme(--breakpoint-md)) {
    .capability-panel {
      padding: calc(var(--spacing) * 6);
    }
  }

  @media (width >= theme(--breakpoint-xl)) {
    .capability-panel {
      grid-template-rows: auto auto;
      padding: calc(var(--spacing) * 5);
    }

    .panel-top {
      grid-column: 1;
      grid-row: 1;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: start;
      column-gap: calc(var(--spacing) * 4);
    }

    .panel-bottom {
      grid-column: 1;
      grid-row: 2;
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
      align-items: start;
      column-gap: calc(var(--spacing) * 4);
    }

    .tool-list {
      display: grid;
      grid-template-columns: repeat(5, minmax(4rem, 1fr));
      justify-items: center;
      column-gap: calc(var(--spacing) * 1.5);
      padding-inline-end: calc(var(--spacing) * 4);
      padding-block-end: 0;
      border-bottom: 0;
      border-inline-end: 1px solid var(--color-border-subtle);
    }

    .panel-bottom .tool-list {
      grid-column: 1;
      grid-row: 1;
    }

    .panel-bottom .capability-list {
      grid-column: 2;
      grid-row: 1;
    }
  }

  @media (width < theme(--breakpoint-xl)) {
    .panel-top,
    .panel-bottom {
      gap: calc(var(--spacing) * 4);
    }
  }
</style>
