---
import Terminal from './Terminal.astro';
import terminalHint from '../assets/terminal-hint.png';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="introduction">
    <p class="eyebrow"><span class="eyebrow-indicator" aria-hidden="true"></span>Software Engineer</p>
    <h1 id="hero-title" class="text-display font-semibold">Anuar Jimenez</h1>
    <p class="subtitle">Building modern web experiences.</p>
    <p class="description">
      Software Engineer focused on building scalable, user-centered applications across web and mobile
      platforms. Experienced in frontend and backend development, with a growing focus on AI-assisted
      engineering and agentic workflows.
    </p>

    <div class="actions">
      <a class="action action-primary" href="#projects">View my work <span aria-hidden="true">→</span></a>
      <a class="action action-secondary" href="#contact">Get in touch</a>
    </div>

    <ul class="metadata" aria-label="Location and availability">
      <li><span class="location-indicator" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M12 21s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12Z" /><circle cx="12" cy="9" r="2.25" /></svg></span>Based in Mexico</li>
      <li><span class="opportunity-indicator" aria-hidden="true"></span>Open to opportunities</li>
    </ul>
  </div>

  <div class="terminal-wrap">
    <Terminal />
    <img
      class="terminal-annotation"
      src={terminalHint.src}
      alt=""
      aria-hidden="true"
      decoding="async"
    />
  </div>
</section>

<style>
  @reference "../styles/global.css";

  .hero {
    display: grid;
    align-items: center;
    gap: calc(var(--spacing) * 12);
  }

  .introduction {
    min-width: 0;
  }

  .terminal-wrap {
    position: relative;
    min-width: 0;
  }

  .terminal-annotation {
    display: none;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    margin-bottom: calc(var(--spacing) * 4);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .eyebrow-indicator {
    width: 0.375rem;
    height: 0.375rem;
    flex: none;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .subtitle {
    max-width: 22rem;
    margin-top: calc(var(--spacing) * 4);
    color: var(--color-secondary);
    font-size: var(--text-section);
    font-weight: var(--font-weight-semibold);
    line-height: var(--text-section--line-height);
  }

  @supports ((background-clip: text) or (-webkit-background-clip: text)) {
    .subtitle {
      background: linear-gradient(100deg, var(--color-secondary) 0%, #b6c2d6 38%, #d45cff 100%);
      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
  }

  .description {
    max-width: 42rem;
    margin-top: calc(var(--spacing) * 6);
    color: var(--color-secondary);
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--spacing) * 3);
    margin-top: calc(var(--spacing) * 8);
  }

  .action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: calc(var(--spacing) * 11);
    padding-inline: calc(var(--spacing) * 5);
    border: 1px solid transparent;
    border-radius: var(--radius-small);
    font-weight: var(--font-weight-semibold);
  }

  .action-primary {
    gap: calc(var(--spacing) * 2);
    color: var(--color-on-accent);
    background: var(--color-accent);
  }

  .action-primary:hover {
    background: var(--color-accent-hover);
  }

  .action-primary:active {
    background: var(--color-primary);
  }

  .action-secondary {
    display: none;
    color: var(--color-primary);
    border-color: var(--color-border-subtle);
    background: var(--color-surface);
  }

  .action-secondary:hover {
    color: var(--color-accent-hover);
    border-color: var(--color-accent);
  }

  .action-secondary:active {
    background: var(--color-surface-elevated);
  }

  .metadata {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--spacing) * 3) calc(var(--spacing) * 6);
    margin-top: calc(var(--spacing) * 8);
    color: var(--color-secondary);
    font-size: var(--text-small);
  }

  .metadata li {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
  }

  .location-indicator {
    display: inline-flex;
    width: 1.375rem;
    height: 1.375rem;
    flex: none;
    color: var(--color-accent);
  }

  .location-indicator svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.75;
  }

  .metadata li > .opportunity-indicator {
    width: calc(var(--spacing) * 2);
    height: calc(var(--spacing) * 2);
    border: 0;
    background: #5effb2;
    border-radius: 50%;
  }

  @media (width >= theme(--breakpoint-lg)) {
    .hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: calc(var(--spacing) * 16);
    }

    .action-secondary {
      display: inline-flex;
    }
  }

  @media (width >= 100rem) {
    .terminal-annotation {
      display: block;
      position: absolute;
      z-index: 1;
      inset-inline-start: calc(100% + var(--spacing) * 4);
      inset-block-end: calc(var(--spacing) * 5);
      width: 9.375rem;
      max-width: calc(100vw - 72rem - 3rem);
      height: auto;
      pointer-events: none;
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 350ms ease-out, transform 350ms ease-out;
    }

    :global(.terminal.terminal-ready) ~ .terminal-annotation {
      opacity: 1;
      transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
      .terminal-annotation {
        transform: none;
        transition: none;
      }
    }
  }
</style>
