---
import Terminal from './Terminal.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="introduction">
    <p class="eyebrow">Software Engineer</p>
    <h1 id="hero-title" class="text-display font-semibold">Anuar Jimenez</h1>
    <p class="subtitle">Building modern web experiences.</p>
    <p class="description">
      Software Engineer focused on building scalable, user-centered applications across web and mobile
      platforms. Experienced in frontend and backend development, with a growing focus on AI-assisted
      engineering and agentic workflows.
    </p>

    <div class="actions">
      <a class="action action-primary" href="#projects">View my work <span aria-hidden="true">→</span></a>
      <a class="action action-secondary" href="#contact">Get in touch</a>
    </div>

    <ul class="metadata" aria-label="Location and availability">
      <li><span aria-hidden="true"></span>Based in Mexico</li>
      <li><span aria-hidden="true"></span>Open to opportunities</li>
    </ul>
  </div>

  <Terminal />
</section>

<style>
  @reference "../styles/global.css";

  .hero {
    display: grid;
    align-items: center;
    gap: calc(var(--spacing) * 12);
  }

  .introduction {
    min-width: 0;
  }

  .eyebrow {
    margin-bottom: calc(var(--spacing) * 4);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .subtitle {
    margin-top: calc(var(--spacing) * 4);
    color: var(--color-primary);
    font-size: var(--text-section);
    font-weight: var(--font-weight-semibold);
    line-height: var(--text-section--line-height);
  }

  .description {
    max-width: 42rem;
    margin-top: calc(var(--spacing) * 6);
    color: var(--color-secondary);
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--spacing) * 3);
    margin-top: calc(var(--spacing) * 8);
  }

  .action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: calc(var(--spacing) * 11);
    padding-inline: calc(var(--spacing) * 5);
    border: 1px solid transparent;
    border-radius: var(--radius-small);
    font-weight: var(--font-weight-semibold);
  }

  .action-primary {
    gap: calc(var(--spacing) * 2);
    color: var(--color-on-accent);
    background: var(--color-accent);
  }

  .action-primary:hover {
    background: var(--color-accent-hover);
  }

  .action-primary:active {
    background: var(--color-primary);
  }

  .action-secondary {
    display: none;
    color: var(--color-primary);
    border-color: var(--color-border-subtle);
    background: var(--color-surface);
  }

  .action-secondary:hover {
    color: var(--color-accent-hover);
    border-color: var(--color-accent);
  }

  .action-secondary:active {
    background: var(--color-surface-elevated);
  }

  .metadata {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--spacing) * 3) calc(var(--spacing) * 6);
    margin-top: calc(var(--spacing) * 8);
    color: var(--color-secondary);
    font-size: var(--text-small);
  }

  .metadata li {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
  }

  .metadata li > span {
    width: calc(var(--spacing) * 1.5);
    height: calc(var(--spacing) * 1.5);
    border: 1px solid var(--color-accent);
    border-radius: 50%;
  }

  @media (width >= theme(--breakpoint-lg)) {
    .hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: calc(var(--spacing) * 16);
    }

    .action-secondary {
      display: inline-flex;
    }
  }
</style>
