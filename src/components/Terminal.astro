<div class="terminal">
  <div class="terminal-body">
    <div class="terminal-static">
      <p class="terminal-prompt">anuar@portfolio:~$</p>
      <div class="terminal-profile">
        <p>Software Engineer</p>
        <p>Based in Mexico</p>
        <p>Focused on modern web experiences</p>
        <p>Focused on AI-assisted development</p>
      </div>
    </div>
    <div class="terminal-animation" aria-hidden="true">
      <div class="terminal-transcript"></div>
    </div>
    <div class="terminal-interactive" hidden>
      <div class="terminal-history"></div>
      <form class="terminal-form">
        <label class="terminal-label" for="terminal-command">Terminal command</label>
        <span class="terminal-input-prompt" aria-hidden="true">anuar@portfolio:~$</span>
        <input id="terminal-command" name="command" type="text" autocomplete="off" spellcheck="false" />
      </form>
    </div>
  </div>
</div>

<style>
  @reference "../styles/global.css";

  .terminal {
    min-width: 0;
    max-width: 42rem;
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-medium);
    background: var(--color-surface);
  }

  .terminal-body {
    position: relative;
    min-width: 0;
    padding: calc(var(--spacing) * 5);
    color: var(--color-secondary);
    font-family: var(--font-mono);
    white-space: pre-wrap;
  }

  .terminal-prompt {
    overflow-wrap: anywhere;
    color: var(--color-terminal);
  }

  .terminal-profile {
    display: grid;
    gap: calc(var(--spacing) * 1.5);
    margin-top: calc(var(--spacing) * 4);
  }

  .terminal-profile p {
    overflow-wrap: anywhere;
  }

  .terminal-animation {
    display: none;
    font: inherit;
    white-space: pre-wrap;
  }

  .terminal-transcript {
    overflow-wrap: anywhere;
  }

  .terminal-command {
    --command-indent: clamp(0.5rem, 1.25ch, 1.25rem);
    padding-inline-start: var(--command-indent);
    text-indent: calc(-1 * var(--command-indent));
  }

  .terminal.is-animating .terminal-static,
  .terminal.is-complete .terminal-static {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .terminal.is-animating .terminal-animation,
  .terminal.is-complete .terminal-animation {
    display: block;
  }

  .terminal-interactive {
    margin-top: calc(var(--spacing) * 4);
  }

  .terminal-history {
    overflow-wrap: anywhere;
  }

  .terminal-history p {
    margin: 0;
  }

  .terminal-history p + p {
    margin-top: calc(var(--spacing) * 1.5);
  }

  .terminal-history .terminal-command,
  .terminal-history .terminal-output {
    margin-top: calc(var(--spacing) * 2);
  }

  .terminal-form {
    display: flex;
    align-items: baseline;
    min-width: 0;
    margin-top: calc(var(--spacing) * 3);
    border-bottom: 2px solid transparent;
  }

  .terminal-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .terminal-input-prompt {
    flex: 0 0 auto;
    color: var(--color-terminal);
  }

  .terminal-form input {
    min-width: 0;
    width: 100%;
    min-height: calc(var(--spacing) * 11);
    padding: 0;
    border: 0;
    outline: 0;
    color: var(--color-primary);
    background: transparent;
    font: inherit;
  }

  .terminal-form:focus-within {
    border-bottom-color: var(--focus-color);
  }

  @media (width >= theme(--breakpoint-lg)) {
    .terminal {
      max-width: none;
      min-height: 18rem;
    }
  }
</style>

<script>
  const terminal = document.querySelector<HTMLElement>('.terminal');

  if (terminal) {
    const staticContent = terminal.querySelector<HTMLElement>('.terminal-static');
    const animation = terminal.querySelector<HTMLElement>('.terminal-animation');
    const transcript = terminal.querySelector<HTMLElement>('.terminal-transcript');
    const terminalBody = terminal.querySelector<HTMLElement>('.terminal-body');
    const interactive = terminal.querySelector<HTMLElement>('.terminal-interactive');
    const form = terminal.querySelector<HTMLFormElement>('.terminal-form');
    const input = terminal.querySelector<HTMLInputElement>('#terminal-command');
    const history = terminal.querySelector<HTMLElement>('.terminal-history');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const sequence = [
      { command: 'whoami', output: ['Software Engineer'] },
      {
        command: 'cat about.txt',
        output: ['Based in Mexico', 'Focused on modern web experiences', 'Focused on AI-assisted development'],
      },
      { command: 'ls interests/', output: [] },
      { command: 'echo "Let\'s build something great!"', output: ["Let's build something great!"] },
    ];
    let hasPlayed = false;

    const commands = new Map<string, { target?: string; output?: string[] }>([
      ['help', { output: ['help', 'about', 'skills', 'experience', 'projects', 'contact', 'clear'] }],
      ['about', { target: '#about' }],
      ['skills', { target: '#skills' }],
      ['experience', { target: '#experience' }],
      ['projects', { target: '#projects' }],
      ['contact', { target: '#contact' }],
      ['clear', {}],
      ['sudo hire anuar', { target: '#contact', output: ['Permission granted. Opening contact section...'] }],
    ]);

    const renderLine = (text: string, className: string) => {
      const line = document.createElement('p');
      line.className = className;
      line.textContent = text;
      transcript?.append(line);
      return line;
    };

    const renderFinalTranscript = () => {
      if (!transcript) return;
      transcript.replaceChildren();
      sequence.forEach(({ command, output }) => {
        renderLine(`anuar@portfolio:~$ ${command}`, 'terminal-command');
        output.forEach((line) => renderLine(line, 'terminal-output'));
      });
    };

    const reserveTranscriptSpace = () => {
      if (!animation || !terminalBody) return;
      renderFinalTranscript();
      animation.style.display = 'block';
      animation.style.position = 'absolute';
      animation.style.top = '0';
      animation.style.left = '0';
      animation.style.width = '100%';
      animation.style.height = 'auto';
      const height = animation.scrollHeight;
      terminalBody.style.minHeight = `${Math.ceil(height)}px`;
      animation.style.display = '';
      animation.style.position = '';
      animation.style.top = '';
      animation.style.left = '';
      animation.style.width = '';
      animation.style.height = '';
      transcript?.replaceChildren();
    };

    const typeLine = async (line: HTMLElement, text: string) => {
      for (const character of text) {
        line.textContent += character;
        await new Promise((resolve) => window.setTimeout(resolve, 32));
      }
    };

    const showInteractivePrompt = () => {
      if (!interactive) return;
      interactive.hidden = false;
    };

    const appendHistoryLine = (text: string, className: string, target?: HTMLElement | null) => {
      target ??= history;
      if (!target) return;
      const line = document.createElement('p');
      line.className = className;
      line.textContent = text;
      target.append(line);
    };

    const navigateTo = (target: string) => {
      window.location.hash = target;
    };

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!input || !history) return;
      const submitted = input.value.trim();
      input.value = '';
      if (!submitted) return;

      appendHistoryLine(`anuar@portfolio:~$ ${submitted}`, 'terminal-command');

      if (submitted === 'clear') {
        history.replaceChildren();
        input.focus();
        return;
      }

      const command = commands.get(submitted);
      if (!command) {
        appendHistoryLine('Command not found. Type "help" to see available commands.', 'terminal-output');
        input.focus();
        return;
      }

      command.output?.forEach((line) => appendHistoryLine(line, 'terminal-output'));
      if (command.target) navigateTo(command.target);
      input.focus();
    });

    const play = async () => {
      if (hasPlayed || !transcript || !staticContent) return;
      hasPlayed = true;
      reserveTranscriptSpace();
      terminal.classList.add('is-animating');

      for (const { command, output } of sequence) {
        const commandLine = renderLine('', 'terminal-command');
        await typeLine(commandLine, `anuar@portfolio:~$ ${command}`);
        await new Promise((resolve) => window.setTimeout(resolve, 180));
        for (const line of output) {
          renderLine(line, 'terminal-output');
        }
        await new Promise((resolve) => window.setTimeout(resolve, 220));
      }

      terminal.classList.remove('is-animating');
      terminal.classList.add('is-complete');
      showInteractivePrompt();
    };

    if (reducedMotion.matches) {
      reserveTranscriptSpace();
      renderFinalTranscript();
      terminal.classList.add('is-complete');
      showInteractivePrompt();
    } else {
      const observer = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
          observer.disconnect();
          void play();
        }
      }, { threshold: 0.35, rootMargin: '0px 0px -10% 0px' });
      observer.observe(terminal);
    }
  }
</script>
